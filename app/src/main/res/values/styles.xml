<resources>
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Using the newly defined colors -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>

    </style>
    <style name="ButtonStyle">
        <item name="android:background">@drawable/button_background</item> <!-- Make sure this drawable exists -->
        <item name="android:textColor">@android:color/white</item> <!-- Or use a custom color -->
        <item name="android:textSize">16sp</item>
        <!-- Add other properties for the button style -->
    </style>
</resources>
